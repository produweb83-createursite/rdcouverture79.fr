{
  // Cloudflare sert les fichiers statiques SANS l'extension .html et renvoie
  // un 307 sur l'URL en .html (html_handling "auto-trailing-slash", le
  // défaut). Le site est donc écrit avec des URLs sans extension partout :
  // canonical, JSON-LD, sitemap et liens internes.
  //
  // Ne PAS passer html_handling à "none" pour garder les .html : dans ce mode
  // seuls les chemins exacts répondent, et la racine "/" tombe sur la 404.
  "name": "rdcouverture79-fr",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./"
  }
}
